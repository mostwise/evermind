# Copy to .env.local and fill in. `.gitignore` covers .env*, so .env.local will
# not be committed — check anyway before your first push.
#
# These are all the variables the application reads. OAuth client IDs and secrets
# do *not* go here: they belong in the Supabase dashboard under
# Authentication → Providers, because Supabase performs the provider handshake,
# not this app.

# --- Required ---------------------------------------------------------------

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://yourdatabaseid.supabase.co

# The anon key is designed to be public: it ships to every browser and is safe
# only because Row Level Security constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Required for account deletion ------------------------------------------

# Bypasses Row Level Security completely — anyone holding it can read and modify
# every row belonging to every user. Never prefix it NEXT_PUBLIC_, never log it,
# never let it reach client code. Used in exactly one place: lib/supabase/admin.ts.
#
# The app boots without it; account deletion returns "not configured" until it is
# set.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Optional ---------------------------------------------------------------

# The canonical public origin, used to resolve link-preview image URLs. Leave it
# unset in development; the sign-in redirect does not need it either, since it is
# derived from the current origin.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
